diff --git a/Apps/DrawThingsCLI/DrawThingsCLI.swift b/Apps/DrawThingsCLI/DrawThingsCLI.swift
index d5989e9..4389b44 100644
--- a/Apps/DrawThingsCLI/DrawThingsCLI.swift
+++ b/Apps/DrawThingsCLI/DrawThingsCLI.swift
@@ -4194,7 +4194,7 @@ public struct DrawThingsCLI: ParsableCommand {
     abstract: "Local inference and training CLI for Draw Things models.",
     discussion: CLIHelpText.root,
     version: CLIIdentity.version,
-    subcommands: [Generate.self, Auth.self, Models.self, Train.self, Completion.self]
+    subcommands: [Generate.self, Auth.self, Models.self, Train.self, Export.self, Completion.self]
   )
 
   private static let invocationCondition = NSCondition()
@@ -5218,6 +5218,39 @@ extension DrawThingsCLI {
     }
   }
 
+  struct Export: ParsableCommand {
+    static let configuration = CommandConfiguration(
+      abstract: "Export utilities.",
+      subcommands: [LoRA.self]
+    )
+
+    struct LoRA: DrawThingsCLICommand {
+      static let configuration = CommandConfiguration(
+        commandName: "lora",
+        abstract: "Export a trained LoRA checkpoint to a safetensors file.")
+
+      @OptionGroup var modelsDirectoryOptions: ModelsDirectoryOptions
+
+      @Option(name: [.short, .long], help: "LoRA checkpoint file name in the models directory.")
+      var file: String
+
+      @Option(name: [.short, .long], help: "Output .safetensors path.")
+      var output: String
+
+      mutating func run(context: DrawThingsCLIContext) throws {
+        let modelsDirectory = try ModelsDirectoryResolver.resolve(
+          context: context, path: modelsDirectoryOptions.modelsDir)
+        ModelZoo.externalUrls = [modelsDirectory]
+        context.print("Models directory: \(modelsDirectory.path)")
+        try LoRAExporter.export(file: file, outputFile: output) { progress, total in
+          if progress == total || progress % 200 == 0 {
+            context.print("export \(progress)/\(total)")
+          }
+        }
+      }
+    }
+  }
+

       var scaler = GradScaler(scale: Float(initialLossScale))
       var scalerSkipCount = 0
+      var consecutiveSkips = 0
       var stopped = false
       var batchCount = 0
       let latentZeros: DynamicGraph.Tensor<FloatType>?
@@ -7673,14 +7681,20 @@ public struct LoRATrainer {
             } else {
               let scaleBefore = scaler.scale
               scaler.step(&optimizers)
-              if scaler.scale < scaleBefore { scalerSkipCount += 1 }
+              if scaler.scale < scaleBefore {
+                scalerSkipCount += 1
+                consecutiveSkips += 1
+              } else {
+                consecutiveSkips = 0
+              }
             }
             if version == .sdxlBase {
               let diagStep = optimizers.first.map { "\($0.step)" } ?? "none"
               print(
                 "[diag] step=\(i) optimizer.step=\(diagStep) scale=\(scaler.scale) skips=\(scalerSkipCount)"

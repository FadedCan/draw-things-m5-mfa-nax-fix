From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: FadedCan <FadedCan@users.noreply.github.com>
Date: Sun, 15 Nov 2026 22:36:54 +0800
Subject: [PATCH 1/4] SDXL LoRA: keep MFA but disable neural accelerators; add
 training diagnostics

- Trainer: force .disableMFANeuralAccelerators for SD/SDXL (M5 MFA attention
  backward produces non-finite gradients via the NA path)
- Trainer: DRAWLORA_LOSS_SCALE / DRAWLORA_GRAD_NAN / DRAWLORA_NO_SCALER hooks,
  scaler skip counter, optimizer parameter count diagnostics
- NNC: expose Parameters.gradientIsNaN for per-parameter gradient checks
- Package.swift: vendor swift-png and swift-protobuf as path dependencies
---
 Libraries/Trainer/Sources/LoRATrainer.swift | 92 ++++++++++++++++++++-
 Package.swift                               |  6 +-
 Vendors/swift-png                           |  1 +
 Vendors/swift-protobuf                      |  1 +
 4 files changed, 93 insertions(+), 7 deletions(-)
 create mode 160000 Vendors/swift-png
 create mode 160000 Vendors/swift-protobuf

diff --git a/Libraries/Trainer/Sources/LoRATrainer.swift b/Libraries/Trainer/Sources/LoRATrainer.swift
index 4000589..b4548a1 100644
--- a/Libraries/Trainer/Sources/LoRATrainer.swift
+++ b/Libraries/Trainer/Sources/LoRATrainer.swift
@@ -5991,6 +5991,40 @@ public struct LoRATrainer {
         DynamicGraph.flags.remove(.disableMFAAppleNeuralEngineAndGpu)
       }
     }
+    // MFA backward produces non-finite gradients for the SD/SDXL trainer, which makes
+    // GradScaler skip every step. Force it off for these versions ("DRAWLORA_ENABLE_MFA=1" to opt back in).
+    // The MFA attention kernels produce non-finite gradients on M5 when they run through the
+    // neural-accelerator path, which makes GradScaler skip every step. Keep the MFA kernels and
+    // only turn off the neural-accelerator dispatch ("DRAWLORA_DISABLE_MFA=1" for the full opt-out).
+    if version == .sdxlBase || version == .sdxlRefiner || version == .ssd1b || version == .v1
+      || version == .v2
+    {
+      DynamicGraph.flags.insert(.disableMFANeuralAccelerators)
+    }
+    if ProcessInfo.processInfo.environment["DRAWLORA_DISABLE_MFA"] != nil {
+      DynamicGraph.flags.insert(.disableMFA)
+    }
+    if ProcessInfo.processInfo.environment["DRAWLORA_ENABLE_MFA"] != nil {
+      DynamicGraph.flags.remove(.disableMFA)
+    }
+    if ProcessInfo.processInfo.environment["DRAWLORA_DISABLE_MFA_ATTN_SPECC"] != nil {
+      DynamicGraph.flags.insert(.disableMFAAttentionSpecializingC)
+    }
+    if ProcessInfo.processInfo.environment["DRAWLORA_DISABLE_MFA_GEMM_SPECM"] != nil {
+      DynamicGraph.flags.insert(.disableMFAGEMMSpecializingM)
+    }
+    if ProcessInfo.processInfo.environment["DRAWLORA_DISABLE_MFA_NAX"] != nil {
+      DynamicGraph.flags.insert(.disableMFANeuralAccelerators)
+    }
+    if ProcessInfo.processInfo.environment["DRAWLORA_DISABLE_MFA_ATTN"] != nil {
+      DynamicGraph.flags.insert(.disableMFAAttention)
+    }
+    if ProcessInfo.processInfo.environment["DRAWLORA_DISABLE_MFA_GEMM"] != nil {
+      DynamicGraph.flags.insert(.disableMFAGEMM)
+    }
+    if ProcessInfo.processInfo.environment["DRAWLORA_DISABLE_MPSGEMM"] != nil {
+      DynamicGraph.flags.insert(.disableMixedMPSGEMM)
+    }
     graph.openStore(session, flags: .readOnly) { sessionStore in
       if version == .flux1 {
         trainFlux1(

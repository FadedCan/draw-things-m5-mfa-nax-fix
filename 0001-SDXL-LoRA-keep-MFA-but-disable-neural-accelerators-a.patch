+                for i in 0..<count { p[i] = Float16(probeUp) }
+              }
+              return .final(tensor)
+            case .Float32:
+              var tensor = Tensor<Float32>(.CPU, format: format, shape: shape)
+              tensor.withUnsafeMutableBytes {

     }
     if ProcessInfo.processInfo.environment["DRAWLORA_ENABLE_MFA"] != nil {
       DynamicGraph.flags.remove(.disableMFA)
+      DynamicGraph.flags.remove(.disableMFANeuralAccelerators)
     }
     if ProcessInfo.processInfo.environment["DRAWLORA_DISABLE_MFA_ATTN_SPECC"] != nil {
       DynamicGraph.flags.insert(.disableMFAAttentionSpecializingC)
@@ -6311,12 +6312,20 @@ public struct LoRATrainer {
         if !cotrainUNet {
           configuration.rank = 0
         }
+        let attentionLevel: FlashAttentionLevel = {
+          switch ProcessInfo.processInfo.environment["DRAWLORA_ATTN_LEVEL"] {
+          case "none": return .none
+          case "scale1": return .scale1
+          case "quantized": return .quantized
+          default: return isMFAEnabled ? .scaleMerged : .none
+          }
+        }()
         unetFixed = LoRAUNetXLFixed(
           batchSize: 1, startHeight: latentsHeight, startWidth: latentsWidth,
           channels: [320, 640, 1280], embeddingLength: (tokenLength, tokenLength),
           inputAttentionRes: [2: [2, 2], 4: [10, 10]], middleAttentionBlocks: 10,
           outputAttentionRes: [2: [2, 2, 2], 4: [10, 10, 10]],
-          usesFlashAttention: isMFAEnabled ? .scaleMerged : .none, LoRAConfiguration: configuration)
+          usesFlashAttention: attentionLevel, LoRAConfiguration: configuration)
         unet = ModelBuilder { size, _ in
           return LoRAUNetXL(
             batchSize: 1, startHeight: size.height, startWidth: size.width,
@@ -6324,7 +6333,7 @@ public struct LoRATrainer {
             middleAttentionBlocks: 10, outputAttentionRes: [2: [2, 2, 2], 4: [10, 10, 10]],
             embeddingLength: (tokenLength, tokenLength), injectIPAdapterLengths: [],
             upcastAttention: ([:], false, [:]),
-            usesFlashAttention: isMFAEnabled ? .scaleMerged : .none,
+            usesFlashAttention: attentionLevel,
             injectControls: false, LoRAConfiguration: configuration
           ).0
         }
@@ -6949,7 +6958,18 @@ public struct LoRATrainer {
         var unetOptimizer = AdamWOptimizer(
           graph, rate: unetLearningRate.upperBound, betas: (0.9, 0.999), decay: 0.001, epsilon: 1e-8
         )
-        unetOptimizer.parameters = unet.parameters.filter(where: { $0.contains("lora") })
+        var trainableParameters = unet.parameters.filter(where: { $0.contains("lora") })
+        // The SDXL fixed encoder owns every cross-attention to_k / to_v LoRA pair (140 of them)
+        // and is normally left out of the optimizer, so those projections stay at their zero
+        // initialisation. Opt in with DRAWLORA_TRAIN_FIXED=1 to train them together with the UNet.
+        if ProcessInfo.processInfo.environment["DRAWLORA_TRAIN_FIXED"] != nil,
+          let unetFixed = unetFixed
+        {
+          let fixedParameters = unetFixed.parameters.filter(where: { $0.contains("lora") })
+          print("[diag] fixed encoder lora parameters=\(fixedParameters.count)")
+          trainableParameters += fixedParameters
+        }
+        unetOptimizer.parameters = trainableParameters
         optimizers.append(unetOptimizer)
         if version == .sdxlBase {
           let diagUp = unet.parameters.filter(where: { $0.contains("lora_up") }).count
@@ -7660,10 +7680,26 @@ public struct LoRATrainer {
               print(
                 "[diag] step=\(i) optimizer.step=\(diagStep) scale=\(scaler.scale) skips=\(scalerSkipCount)"
               )
